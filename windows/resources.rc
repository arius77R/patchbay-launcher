#include <windows.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,4,0
PRODUCTVERSION 0,9,4,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Patchbay Launcher"
      VALUE "ProductName", "Patchbay Launcher"
      VALUE "FileVersion", "0.9.4"
      VALUE "ProductVersion", "0.9.4"
      VALUE "OriginalFilename", "Patchbay Launcher.exe"
      VALUE "Comments", "Installs, updates and starts Patchbay Mod Loader for Bitwig Studio. Not affiliated with Bitwig GmbH."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
